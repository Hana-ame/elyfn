# 复制为 .env 后修改（Docker 与非 Docker 部署通用）
# 语法：KEY=VALUE；注释可单独成行，也可写在值后面（要求 # 前有空格）；
#       值本身含 # 或空格时用引号包裹，如 ELYFN_ADMIN_KEY="p#ss word"
# 监听地址（支持直接写 ip:port，优先级高于下方 ELYFN_HOST/ELYFN_PORT；例如 127.0.0.1:3000 或 0.0.0.0:3000）
ELYFN_ADDR=0.0.0.0:3000
# 拆分写法（当 ELYFN_ADDR 留空时生效）
ELYFN_HOST=0.0.0.0
ELYFN_PORT=3000
# Docker Compose 宿主机对外映射地址（默认仅本机 127.0.0.1:3000）
ELYFN_BIND_ADDR=127.0.0.1:3000

# 必填：写/管理权限密钥（用于 PUT 上传、DELETE 删除、GET /manage/list 与源码下载）
ELYFN_ADMIN_KEY=change-me-to-a-strong-secret

# 可选：POST 执行接口与 GET /catalog 目录接口密钥；留空表示允许公网/公开调用
ELYFN_EXEC_KEY=

# 可选：CORS 允许的 Origin（默认 *；生产可改为具体前端域名，留空禁用 CORS 响应头）
ELYFN_CORS_ORIGIN=*

# 可选：允许透传给函数 Worker 的额外环境变量名（逗号分隔；ELYFN_FN_* 前缀变量默认自动透传，宿主密钥默认隔离）
ELYFN_WORKER_ENV_ALLOW=

# Worker 并发与资源限制
ELYFN_MAX_CONCURRENCY=8
# 管理员上传测试 Worker 最大并发（独立并发池，与公网执行隔离，避免公网打满后管理员传不上去）
ELYFN_MAX_TEST_CONCURRENCY=2
ELYFN_MAX_WORKER_MEM_MB=64
ELYFN_TIMEOUT_MS=5000
ELYFN_MAX_FILE_SIZE=2097152
ELYFN_MAX_BODY_SIZE=1048576

# 可选：函数存储目录（默认 <项目根>/functions；Docker 镜像内为 /app/functions，compose 已自动指定）
# ELYFN_BASE_DIR=/opt/elyfn/functions
