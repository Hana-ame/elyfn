# 复制为 .env 后修改（Docker 与非 Docker 部署通用）
ELYFN_PORT=3000
ELYFN_HOST=0.0.0.0

# 必填：写/管理权限密钥（用于 PUT 上传、DELETE 删除、GET 列表与下载）
ELYFN_ADMIN_KEY=change-me-to-a-strong-secret

# 可选：POST 执行接口密钥；留空表示允许公网/公开调用
ELYFN_EXEC_KEY=

# Worker 并发与资源限制
ELYFN_MAX_CONCURRENCY=8
ELYFN_MAX_WORKER_MEM_MB=64
ELYFN_TIMEOUT_MS=5000
ELYFN_MAX_FILE_SIZE=2097152
ELYFN_MAX_BODY_SIZE=1048576
